# Porta da aplicação
PORT=3000

# Chave de acesso ao painel administrativo (Opcional em dev / Recomendada em produção)
# Ex: openssl rand -hex 32
# Quando definida, exige o envio do header 'x-api-key' em chamadas /api
ADMIN_API_KEY=

# Segredo do webhook do WhatsApp (Evolution API / Z-API / n8n)
# Ex: openssl rand -hex 24
# Envie via query param (?token=SEU_SEGREDO) ou header (x-webhook-secret: SEU_SEGREDO)
WEBHOOK_SECRET=

# Provedor de IA ativo: 'gemini', 'openai' ou 'deepseek' (ou 'mock' para testar sem chaves)
AI_PROVIDER=gemini

# Chaves de API
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Modelo selecionado
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.1-flash-lite
DEEPSEEK_MODEL=deepseek-chat

# Modo de Revisão Humana / Copiloto (false: auto-envio direto | true: vendedor precisa aprovar antes de enviar)
AI_REVIEW_MODE=false

# Dados da Concessionária / Loja
DEALERSHIP_NAME=AutoPrime Veículos
DEALERSHIP_CITY=São Paulo - SP
DEALERSHIP_ADDRESS=Av. dos Bandeirantes, 1500
DEALERSHIP_PHONE=(11) 99999-8888
DEFAULT_SELLER_NAME=Lucas Mendes

# Taxa de juros mensal média estimada para simulação de financiamento (ex: 1.49%)
AVERAGE_MONTHLY_INTEREST_RATE=0.0149
